        print("H.anh hub: Đã bật Gojo Tech New")
    end
})

---------------------------------------------------------
-- 2. NỘI DUNG TAB: MAIN
---------------------------------------------------------
TabMain:Section({ Title = "Hỗ Trợ Ngắm & Khóa Mục Tiêu" })

TabMain:Toggle({
    Title = "Silent Aim",
    Desc = "Tự động đánh trúng mục tiêu trong tầm ngắm",
    Default = false,
    Callback = function(state)
        print("H.anh hub - Silent Aim:", state)
    end
})

TabMain:Toggle({
    Title = "Cam Lock",
    Desc = "Khóa camera theo sát người chơi gần nhất",
    Default = false,
    Callback = function(state)
        print("H.anh hub - Cam Lock:", state)
    end
})

---------------------------------------------------------
-- 3. NỘI DUNG TAB: FIXLAG
---------------------------------------------------------
TabFixLag:Section({ Title = "Cài Đặt Giảm Lag" })

TabFixLag:Button({
    Title = "Xóa Hiệu Ứng (Remove Textures)",
    Desc = "Giúp tăng FPS khi combat đông người",
    Callback = function()
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Material = Enum.Material.SmoothPlastic
            end
        end
        print("H.anh hub: Đã tối ưu đồ họa thành công!")
    end
})

-- Thông báo khi tải thành công
Lib:Notify({
    Title = "H.anh hub",
    Content = "Đã tải menu H.anh hub cùng ảnh nền thành công!",
    Duration = 4
})
