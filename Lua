-- CÀI ĐẶT HÌNH NỀN SCRIPT (BACKGROUND / WATERMARK)
---------------------------------------------------------
pcall(function()
    local coreGui = game:GetService("CoreGui")
    local rayfieldUI = coreGui:FindFirstChild("Rayfield") or coreGui:FindFirstChild("RayfieldLibrary")
    if rayfieldUI then
        local mainFrame = rayfieldUI:FindFirstChild("Main", true)
        if mainFrame then
            local bgImage = Instance.new("ImageLabel")
            bgImage.Name = "CustomBackground"
            bgImage.Size = UDim2.new(1, 0, 1, 0)
            bgImage.Position = UDim2.new(0, 0, 0, 0)
            bgImage.Image = "rbxassetid://113467932323625" -- ID ảnh của bạn
            bgImage.BackgroundTransparency = 1
            bgImage.ImageTransparency = 0.65 -- Độ mờ ảnh
            bgImage.ScaleType = Enum.ScaleType.Crop
            bgImage.ZIndex = 0
            bgImage.Parent = mainFrame
        end
    end
end)

