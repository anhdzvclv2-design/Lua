-- Tải thư viện giao diện mượt mà (WindUI Library)
local Lib = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/source.lua"))()

-- Tạo cửa sổ chính (Window) với tên H.anh hub
local Window = Lib:CreateWindow({
    Title = "H.anh hub",
    SubTitle = "v1.4.0 - TSB Edition",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 360),
    Acrylic = false, -- Tắt acrylic để hiển thị rõ ảnh nền
    Theme = "Dark",
})

---------------------------------------------------------
-- CÀI ĐẶT HÌNH NỀN SCRIPT (BACKGROUND / WATERMARK)
---------------------------------------------------------
local BackgroundImageID = "rbxassetid://113467932323625" -- ID ảnh nền của bạn

pcall(function()
    local mainFrame = Window.UIElements and Window.UIElements.Main or nil
    if mainFrame then
        local bgImage = Instance.new("ImageLabel")
        bgImage.Name = "CustomBackground"
        bgImage.Size = UDim2.new(1, 0, 1, 0)
        bgImage.Position = UDim2.new(0, 0, 0, 0)
        bgImage.Image = BackgroundImageID
        bgImage.BackgroundTransparency = 1
        bgImage.ImageTransparency = 0.65 -- Độ mờ ảnh (0: rõ nhất, 1: ẩn)
        bgImage.ScaleType = Enum.ScaleType.Crop
        bgImage.ZIndex = 0
        bgImage.Parent = mainFrame
    end
end)

-- Tạo các Tab danh mục giao diện
local TabAutoTech = Window:Tab({ Title = "Auto Tech", Icon = "zap" })
local TabMain     = Window:Tab({ Title = "Main", Icon = "home" })
local TabTongHop  = Window:Tab({ Title = "TongHop", Icon = "layers" })
local TabMovesets = Window:Tab({ Title = "Movesets", Icon = "box" })
local TabTech     = Window:Tab({ Title = "Tech", Icon = "globe" })
local TabFixLag   = Window:Tab({ Title = "FixLag", Icon = "rocket" })
local TabTSB      = Window:Tab({ Title = "TSB", Icon = "shield" })
local TabMisc     = Window:Tab({ Title = "Misc", Icon = "list" })

---------------------------------------------------------
